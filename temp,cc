// Moderni säieturvallinen tulostus
template<typename... Args>
void safe_print(Args&&... args) {
    static std::mutex cout_mtx;
    std::lock_guard lock(cout_mtx);
    (std::cout << ... << args) << std::endl;
}

// Tehtäväluokka – ei enää raakaosoittimia
struct ProjectTask {
    enum Type { WRITE_CODE, TEST_CODE, ATTEND_MEETING, VISIT_CUSTOMER };
    uint32_t id;
    Type type;

    std::string to_string() const {
        switch(type) {
            case WRITE_CODE: return "Writing Modern C++23";
            case TEST_CODE: return "Testing on RPi 5";
            case ATTEND_MEETING: return "Meeting with AI";
            case VISIT_CUSTOMER: return "Customer Visit (Fedora 44)";
            default: return "Unknown";
        }
    }
};

// Säieturvallinen jono cond_varilla (Poistetaan CPU-kuorma odottaessa)
class TaskQueue {
    std::queue<std::unique_ptr<ProjectTask>> tasks;
    std::mutex mtx;
    std::condition_variable cv;
public:
    void push(std::unique_ptr<ProjectTask> task) {
        {
            std::lock_guard lock(mtx);
            tasks.push(std::move(task));
        }
        cv.notify_one();
    }

    std::unique_ptr<ProjectTask> pop(std::stop_token st) {
        std::unique_lock lock(mtx);
        // Odotetaan tehtävää tai lopetussignaalia
        cv.wait(lock, st, [this] { return !tasks.empty(); });
        
        if (tasks.empty()) return nullptr;

        auto task = std::move(tasks.front());
        tasks.pop();
        return task;
    }
};

// Perusluokka "Nisäkäs" – hyödyntää jthreadia
class Mammal {
protected:
    std::jthread basic_needs_thread;
    std::atomic<bool> is_sleeping{false};

    void start_basic_needs() {
        basic_needs_thread = std::jthread([this](std::stop_token st) {
            while (!st.stop_requested()) {
                std::this_thread::sleep_for(5s);
                is_sleeping = true;
                safe_print("Mammal is sleeping...");
                std::this_thread::sleep_for(2s);
                is_sleeping = false;
                safe_print("Mammal woke up!");
            }
        });
    }
};

// Ohjelmistokehittäjä – Erikoistunut ihminen
class SoftwareDeveloper : public Mammal {
    std::jthread work_thread;
    int id;

public:
    SoftwareDeveloper(int id, TaskQueue& queue) : id(id) {
        start_basic_needs();
        work_thread = std::jthread([this, &queue](std::stop_token st) {
            while (!st.stop_requested()) {
                if (!is_sleeping) {
                    auto task = queue.pop(st);
                    if (task) {
                        safe_print("Dev ", id, " is carrying out task: ", task->to_string());
                        std::this_thread::sleep_for(1s); // Simuloidaan työtä
                    }
                } else {
                    std::this_thread::sleep_for(100ms);
                }
            }
        });
    }
};

int main() {
    safe_print("Starting Project on RPi 5 / Fedora 44 Environment...");
    
    TaskQueue global_backlog;
    std::vector<std::unique_ptr<SoftwareDeveloper>> team;

    // Luodaan tiimi (12 kehittäjää)
    for (int i = 1; i <= 12; ++i) {
        team.push_back(std::make_unique<SoftwareDeveloper>(i, global_backlog));
    }

    // Projektipäällikkö (Main-säie tässä esimerkissä) luo tehtäviä
    std::mt19937 rng(std::random_device{}());
    std::uniform_int_distribution<int> dist(0, 3);

    for (int i = 1; i <= 20; ++i) {
        std::this_thread::sleep_for(500ms);
        auto task = std::make_unique<ProjectTask>(i, static_cast<ProjectTask::Type>(dist(rng)));
        safe_print("PM added task #", i);
        global_backlog.push(std::move(task));
    }

    safe_print("Project simulation running. Press Enter to shutdown.");
    std::cin.get();

    return 0;
}